                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="30"
                android:type="radial">
                <item android:offset="0.0" android:color="#995DCAA5" />
                <item android:offset="0.7" android:color="#335DCAA5" />
                <item android:offset="1.0" android:color="#005DCAA5" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Thin outer ring -->
    <path
        android:pathData="M54,31A23,23 0 1,1 54,77A23,23 0 1,1 54,31Z"
        android:strokeWidth="1.8"
        android:strokeColor="#FF5DCAA5"
        android:fillColor="#00000000" />
